# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# SUMO / netedit working files
*.xml.bak
*.sumocfg.bak
netedit*.xml
.viewsettings.xml
settings.xml
tripinfo*.xml
summary*.xml
edgeData*.xml
vehroutes*.xml

# Experiment raw output.
# results/runs/ holds one pair of CSV files per simulation - hundreds of
# files that are regenerated by `run_experiments.py`.  Only the experiment
# index and the aggregated table are worth committing.
results/runs/

# Raw SUMO output from a single analysed run.  Hundreds of KB to a few MB and
# regenerated by `analyse_run.py`, so only the derived tables are committed.
results/*/*.xml
results/*/*.png
results/*/outputs.add.xml

# Networks and demand built from OpenStreetMap.
# ~10 MB each and reproducible with `scripts/build_from_osm.py`, so they are
# generated rather than committed.  The hand-written cross.*.xml files ARE
# committed, because those are source rather than build output.
net/real.net.xml
net/real.net.rou.xml
net/*.osm
net/*.osm.gz

# editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

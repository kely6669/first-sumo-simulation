# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# linters / type checkers leave their caches in the repo root
.ruff_cache/
.mypy_cache/
.pytest_cache/

# SUMO / netedit working files
*.xml.bak
*.sumocfg.bak
netedit*.xml
.viewsettings.xml
settings.xml
tripinfo*.xml
summary*.xml
edgeData*.xml
vehroutes*.xml
# intermediate trip list written by randomTrips.py
*.trips.xml

# Experiment raw output.
# results/runs/ holds one directory per simulation, each with the XML that
# SUMO wrote plus a sumo.log.  Hundreds of files, all regenerated by
# `run_experiments.py`, so only the index and the aggregated tables are
# committed.
results/runs/

# The two runs produced by `3_signal_control.py --compare`.  Working data:
# the numbers are printed, and --csv writes the table wherever you want it.
results/control/

# Raw SUMO output from a single analysed run.  Hundreds of KB to a few MB and
# regenerated by `analyse_run.py`, so only the derived tables are committed.
results/*/*.xml
results/*/*.png
results/*/*.log
results/*/outputs.add.xml

# Compiled networks are build output, not source.
#
# net/cross.net.xml is compiled by `scripts/generate_network.py` from the
# hand-written net/cross.{nod,edg,con}.xml; net/real.net.xml is compiled by
# `scripts/build_from_osm.py` from OpenStreetMap data.  Both are reproducible
# and both are large or noisy (netconvert stamps a generation time into every
# one), so the *inputs* are committed and the outputs are not.
#
# Anything that needs the network builds it on demand - see
# sumo_config.ensure_network().
net/cross.net.xml
net/real.net.xml
net/real.net.rou.xml
net/*.osm
net/*.osm.gz

# editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
